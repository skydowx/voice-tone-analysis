# Required for live inference. Never commit the real key.
GEMINI_API_KEY=

APP_ENV=development
APP_VERSION=development
APP_DATA_DIR=var
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=384
GEMINI_THINKING_LEVEL=minimal
GEMINI_EMOTION_STRATEGY=transcript_local_profiles
GEMINI_AUDIO_VIEW=full
MAX_BATCH_FILES=100
MAX_FILE_BYTES=52428800
MAX_BATCH_BYTES=262144000
PROCESSING_CONCURRENCY=2
LONG_SILENCE_SECONDS=10.0

# Override all three before a public deployment.
EVALUATOR_USERNAME=evaluator
EVALUATOR_PASSWORD=change-me-local
# Prefer this PBKDF2 value in production; generate it with scripts/hash_password.py.
EVALUATOR_PASSWORD_HASH=
SESSION_SECRET=change-me-before-deploying
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
